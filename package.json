{
  "name": "naming-app",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "verify": "node scripts/verify.mjs",
    "dev": "npm run build:data && vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run format:check && npm run build:data && npm run verify && tsc --noEmit && npm run lint && npm run test && vite build && node scripts/size-check.mjs",
    "build:single": "npm run build && npm run single",
    "single": "SINGLE=1 vite build --outDir dist-single --emptyOutDir && node scripts/size-check.mjs dist-single --single",
    "serve": "python3 -m http.server 5178 --directory dist",
    "audit:design": "node scripts/design-audit.mjs",
    "check": "npm run build && npm run test:e2e && npm run audit:design"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pinyin-pro": "3.29.5",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.12"
  }
}
